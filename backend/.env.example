# Application Settings
APP_NAME=Prism
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prism
LOG_LEVEL=INFO

# Auth / Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
